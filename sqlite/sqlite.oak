/*
SQLite3 interface for Oak.
*/

tag!("no_dialect");
package!("std");
use_rule!("std");
include!("std/string.oak");
link!("sqlite/sqlite.o");

////////////////////////////////////////////////////////////////

let sqlite_res: struct
{
    data: [][]string,
    nrows, ncols: u128,
}

let Copy(self: ^sqlite_res, rows: u128, cols: u128
    ) -> sqlite_res;

////////////////////////////////////////////////////////////////

let sqlite: struct
{
    __db: ptr,
}

let New, Del(self: ^sqlite) -> void;
let Copy(self: ^sqlite, path: string) -> sqlite;
let sql(self: ^sqlite, stmt: string) -> sqlite_res;
