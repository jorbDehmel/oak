// Ensure that this will work with other dialects
tag!("no_dialect");

/*
String formatting macro. Works like printf.

format!("flump % buzz %", foo, fizz)
=>
("flump " + to_string(foo) + " buzz " + to_string(fizz))
*/
let format!(argc: i32, argv: [][]i8) -> i32
{
    package!("std");
    use_rule!("std");

    let cur_char = 0i32;
    let cur_arg = 2i32;
    let is_valid = true;
    let is_in_str = false;
    let is_beginning = true;

    if argc < 2i32
    {
        print(
            "c::panic!(\"Missing format! string.\");\n"
        );
        0i32
    }

    // Iterate through chars in format string
    print("(");
    while Get(Get(argv, 1i32), cur_char) != 0u8
    {
        let cur: i8 = Get(Get(argv, 1i32), cur_char);

        // Arg access
        if cur == to_i8("%")
        {
            is_beginning = false;
            if is_in_str
            {
                print("\" + ");
                is_in_str = false;
            }

            if (cur_arg >= argc)
            {
                // Error case
                print(
                    "c::panic!(\"Missing format! "
                    "argument(s).\");\n"
                );
                0i32
            }
            else
            {
                // Formatted print
                print("to_string(");
                print(ptrarr!(argv, cur_arg));
                print(")");
                ++cur_arg;
            }
        }

        // Regular char
        else 
        {
            if !is_in_str
            {
                if is_beginning
                {
                    is_beginning = false;
                }
                else
                {
                    print(" + ");
                }

                print("\"");
                is_in_str = true;
            }

            if (cur == to_i8("\\"))
            {
                // Escape character
                // If next is %, do not print the escape
                // character. Otherwise, do.

                cur = Get(Get(argv, 1i32), cur_char + 1i32);

                if cur == 0i8
                {
                    print("\\\\");
                }
                else if cur == to_i8("%")
                {
                    print("%");
                    ++cur_char;
                }
                else
                {
                    print("\\");
                    print(cur);
                    ++cur_char;
                }
            }
            else if (cur == to_i8("\""))
            {
                print("\\\"");
            }
            else if (cur == to_i8("\n"))
            {
                print("\\n");
            }
            else
            {
                print(cur);
            }
        }

        cur_char += 1i32;
    }

    if is_in_str
    {
        print("\"");
    }
    print(")");

    // Warn if more arguments are provided than are needed
    if (cur_arg < argc)
    {
        print(
            "c::panic!(\"Unused format! argument(s).\");\n"
        );
    }

    0i32
}

