/*
Tests trying to eliminate ptr macros (ptrcpy!, ptrarr!)
*/

package!("std");
use_rule!("std");

let Copy<t>(self: mut ^t, from: u128) -> ^t
{
    ptrcpy!(^self, 0u128);
    ^self
}

let Copy<t, u>(self: mut ^t, from: ^u) -> ^t
{
    ptrcpy!(^self, from);
    ^self
}

let Copy<t, u>(self: mut []t, from: []u) -> []t
{
    ptrcpy!(^self, from);
    ^self
}

let main() -> i32
{
    // pointer stuff
    let p1: ptr;
    let p2: ptr;
    @p1 = 0u128;
    @p2 = 0u128;

    @p1 = p2;

    let a1: []i32;
    let a2: []i32;

    alloc!(a1, 10u128);
    alloc!(a2, 20u128);

    print(a1.Get(5u128));
    print(a2.Get(18u128));

    let backup: []i32;
    Copy(@backup, a1);

    a1 = a2;

    a1 = backup;

    free!(a1);
    free!(a2);

    0i32
}
