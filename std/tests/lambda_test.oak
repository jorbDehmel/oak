/**
 * @brief Tests non-capturing lambdas in Oak.
 */

include!(
  "std/std.oak",
  // "std/rules.oak"
);
include!("std/assert.oak");
rule::use!("std");

let call_on_zero(fn: ^(_: i32) -> i32) -> i32 {
  return fn(0i32);
}

let main() -> i32 {
  let expected, observed: i32;
  expected = 123i32;
  observed = call_on_zero(
    (arg: i32) -> i32 {
      print("Hello from within a lambda!\n");
      return 123i32;
    }
  );

  assert!(expected == observed);

  return 0i32;
}
