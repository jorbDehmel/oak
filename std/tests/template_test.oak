/*
A basic test of templates in oak
*/

include!("std/std.oak");

let println<T>(what: T) -> void {
  print(what);
  endl();
}

let printtwo<A, B>(a: A, b: B) -> void {
  println(a);
  println(b);
}

let main() -> i32 {
  println(123 i32);
  println(2.0 f64);

  printtwo(432u64, "hi there");

  return 0i32;
}
