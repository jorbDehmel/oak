/*
Tests the std/string_ops.oak file
*/

package!("std");
use_rule!("std");
include!(
    "std/string.oak",
    "std/string_ops.oak",
    "std/assert.oak",
    "std/printf.oak"
);

let assert_eq!(c: i32, v: []str) -> i32
{
    package!("std");
    use_rule!("std");
    include!("std/printf.oak");

    if c != 3 && c != 4
    {
        print(
            "c::panic!(\"Please provide 2 or 3 "
                        "args to assert_eq!.\");"
        );
        0i32
    }

    printf!(
        "if (% != %) {"
        "print(\"~~~~~~~~~~~~~~~~~~~~"
                "~~~~~~~~~~~~~~~~~~~~\\n\");"
        "print(\"Failed assertion: \");"
        "print(file!);"
        "print(\":\");"
        "print(line!);"
        "endl();"
        "print(%);"
        "print(\" != \");"
        "print(%);"
        "endl();",
        v.Get(1),
        v.Get(2),
        v.Get(1),
        v.Get(2)
    );

    if c >= 4
    {
        printf!(
            "print(\"%\");",
            v.Get(3)
        );
    }

    print(
        "print(\"~~~~~~~~~~~~~~~~~~~~"
                "~~~~~~~~~~~~~~~~~~~~\\n\");"
        "internal_panic();"
        "}"
    );

    0i32
}

let main() -> i32
{
    assert_eq!(to_string(123i32), "123");

    assert!(
        to_string(-123i32) == "-123"
    );

    assert!(
        to_string(1.23f64) == "1.23"
    );

    0i32
}
