/*

*/

include!("std/std.oak");
include!("std/panic.oak");
include!("std/fs.oak");

let main() -> i32 {
  if (Not(fs::exists(FILE!))) {
    panic();
  } else {
    print(FILE!);
    print(" exists (good)\n");
  }

  fs::mkdir("test_junk_dir");
  fs::chdir("test_junk_dir");
  fs::chdir("..");
  fs::remove("test_junk_dir");

  return 0i32;
}
