/*
Tests output files
*/

include!(
  "std/std.oak",
  "std/ofile.oak",
  "std/fs.oak",
  "std/assert.oak");

let main() -> i32 {
  if (fs::exists("foo.txt")) {
    fs::remove("foo.txt");
  }

  let f: ofile;
  f = "foo.txt";

  write(f, "hi there!");

  Del(f);

  assert!(fs::exists("foo.txt"));
  fs::remove("foo.txt");

  return 0i32;
}
