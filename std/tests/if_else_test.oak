/*
Tests if statements w/ else clauses
*/

include!("std/std.oak");

let main() -> i32 {
  let condition: bool;
  condition = true;

  if (condition) {
    print("Condition was true\n");
  } else {
    print("Condition was false\n");
  }

  if !condition {
    print("!Condition was true\n");
  } else {
    print("!Condition was false\n");
  }

  return 0i32;
}
