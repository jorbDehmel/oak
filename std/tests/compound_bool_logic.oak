/*
Tests more complicated boolean logic
*/

include!("std/std.oak");

let main() -> i32 {
  if (true && (true || false)) {
    print(LINE!);
    endl();
  }
  if ((false || true) && true) {
    print(LINE!);
    endl();
  }

  let to_flip: bool;
  to_flip = false;
  ~to_flip;
  if (!to_flip) {
    return 123i32;
  }

  return 0i32;
}
