/*
Fizz buzz
*/

include!("std/std.oak");

let is_divisible_by(what: i32, by: i32) -> bool {
  return what % by == 0i32;
}

let main() -> i32 {
  let counter: i32;
  counter = 0i32;
  while (counter < 20i32) {
    let flag: bool;
    flag = false;
    if (is_divisible_by(counter, 3i32)) {
      flag = true;
      print("Fizz");
    }
    if (is_divisible_by(counter, 5i32)) {
      flag = true;
      print("Buzz");
    }
    if (!flag) {
      print(counter);
    }
    endl();
    ++counter;
  }
  return 0i32;
}
