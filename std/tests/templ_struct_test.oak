/*
Tests templated structs
*/

include!("std/std.oak");

let foo<T> {
  let Foo<T>: struct {
    data: T,
  }
}

let New(self: ^foo<i32>::Foo) -> void {
  self.data = 0i32;
  print("Hi!\n");
}

let New(self: ^foo<bool>::Foo) -> void {
  self.data = false;
  print("Hello!\n");
}

let main() -> i32 {
  let inst_1: foo<i32>::Foo;
  let inst_2: foo<bool>::Foo;

  return 0i32;
}
