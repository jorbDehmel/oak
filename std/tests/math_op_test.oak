include!("std/std.oak");

let Fizz: struct {
  member: u64
}

let main() -> i32 {
  print(1i32 + 2i32);
  endl();

  print(2i32 / 3i32 / 5i32);
  endl();

  print(2i32 / 3i32 / Add(1i32, 2i32));
  endl();

  print(2i32 / 3i32 + 5i32);
  endl();

  print(5i32 + 2i32 / 3i32);
  endl();

  let a: i32;
  a = 1i32 + 2i32 + 3i32;

  let b: Fizz;
  b.member = 100u64;
  print(b.member * b.member);
  endl();

  return 0i32;
}
