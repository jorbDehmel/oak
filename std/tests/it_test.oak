/*
Tests a basic iterator in Oak.
*/

package!("std");
use_rule!("std");
include!(
    "std/printf.oak",
    "std/iterable.oak"
);

let a: struct
{
    data: [10]i32,
}
let a::iterator: struct
{
    on: ^a,
    pos: u128,
}

let Copy(
    self: mut a::iterator,
    from: a::iterator
    ) -> a::iterator
{
    ptrcpy!(self.on, from.on);
    self.pos = from.pos;
    ^self
}
let begin(self: mut a) -> a::iterator
{
    let out: a::iterator;
    ptrcpy!(out.on, self);
    out.pos = 0u128;

    out
}
let end(self: mut a, iter: mut a::iterator) -> bool
{
    iter.pos >= 10u128
}
let Incr(self: mut a::iterator)
{
    ++self.pos;
}
let get(self: mut a::iterator) -> ^i32
{
    @ptrarr!(self.on.data, self.pos)
}

let main() -> i32
{
    let what: a;
    where a, a::iterator is iterable;
    // where a is iterable;
    let i: u128 = 0u128;

    for item in what
    {
        printf!("Item %\n", i);
        ++i;
    }

    0i32
}
