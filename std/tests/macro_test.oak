/*
Tests inline and functional macros
*/

include!("std/io.oak");

// let blimbo! = true;

let foo!(c: i32, v: [][]i8) -> i32 {
  include!("std/io.oak");
  print(
    "print(\"Hello, world!\\n\");\n"
  );
}

let main() -> i32 {
  print("Hello from ");
  print(FILE!);
  endl();

  foo!();

  // Macro nonexistence replacement
  // If you do it at compile-time, this becomes preprocessor
  // conditional compilation
  if (blimbo!false) {
    print("'blimbo!' exists!\n");
  } else {
    print("'blimbo!' does not exist (sad)...\n");
  }

  return 0i32;
}
