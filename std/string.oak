/**
 * @file
 * @brief Defines the dynamically-allocated `String` class
 */

pragma!("no_dialect");
include!(
  "std/operators.oak",
  "std/io.oak",
  "std/panic.oak",
  "std/c_str.oak",
  "std/rules.oak"
);
link!("std/string.o");
rule::use!("std");

////////////////////////////////////////////////////////////////
// Struct definition

/**
 * @brief A self-resizing, dynamically-allocated, RAII string
 */
let String: struct {
  __c_str: []i8,
  __size: uint
}

////////////////////////////////////////////////////////////////
// Signatures

/// Create an empty string. EXTERN
let New(self: ^String) -> void;

/// Delete a string's memory if it has any. EXTERN
let Del(self: ^String) -> void;

/// Deep copy of another string. EXTERN
let Copy(self: ^String, other: String) -> ^String;

/// Initialize from a null-terminated C-string. EXTERN
let Copy(self: ^String, other: []i8) -> ^String;

/// Get the i-th BYTE (not unicode codepoint) of the string
let Get(self: ^String, i: uint) -> i8;

/// String concatenation
let Add(lhs: String, rhs: String) -> String;

/// String equality
let Eq(lhs: String, rhs: String) -> bool;

/// String inequality
let Neq(lhs: String, rhs: String) -> bool;

/// Allocate enough space for `size` bytes of data
let reserve(self: ^String, size: uint) -> void;

/// Print the string
let print(what: String) -> void;

////////////////////////////////////////////////////////////////
// Implementations

let Copy(self: ^String, c: i8) -> ^String {
  reserve(self, 1uint);
  Get(self.__c_str, 0uint) = c;
  Get(self.__c_str, self.__size) = 0i8;
  return self;
}

let Get(self: ^String, i: uint) -> i8 {
  if (i >= self.__size) {
    panic("Out of range string index!");
  }
  return Get(self.__c_str, i);
}

let Add(lhs: String, rhs: String) -> String {
  let out: String;
  reserve(out, lhs.__size + rhs.__size);
  let i: uint;
  i = 0uint;

  while (i < lhs.__size) {
    Get(out.__c_str, out.__size) = Get(lhs.__c_str, i);
    ++out.__size;
    ++i;
  }

  i = 0uint;
  while (i < rhs.__size) {
    Get(out.__c_str, out.__size) = Get(rhs.__c_str, i);
    ++out.__size;
    ++i;
  }

  return out;
}

let Eq(lhs: String, rhs: String) -> bool {
  return strcmp(lhs.__c_str, rhs.__c_str) == 0int;
}

let Neq(lhs: String, rhs: String) -> bool {
  return strcmp(lhs.__c_str, rhs.__c_str) != 0int;
}

let reserve(self: ^String, size: uint) -> void {
  if (self.__size < size + 1uint) {
    if (self.__size != 0uint) {
      free!(self.__c_str);
    }
    self.__size = size + 1uint;
    alloc!(self.__c_str, self.__size);
  }
}

let print(what: String) -> void {
  if (what.__size > 0uint) {
    print(what.__c_str);
  }
}
