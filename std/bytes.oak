/**
 * @file
 * @brief Byte objects of constant length. These are mostly used
 * for interfacial struct packing and pointer casting.
 */

pragma!("no_dialect");

/// One byte of data
let Byte: struct {
  _: u8
}
let New(self: ^Byte) -> void {}

/// Two bytes of data
let TwoBytes: struct {
  _, __: Byte
}
let New(self: ^TwoBytes) -> void {}

/// Four bytes of data
let FourBytes: struct {
  _, __: TwoByte
}
let New(self: ^FourBytes) -> void {}

/// Eight bytes of data
let EightBytes: struct {
  _, __: FourBytes
}
let New(self: ^EightBytes) -> void {}

/// Sixteen bytes of data
let SixteenBytes: struct {
  _, __: EightBytes
}
let New(self: ^SixteenBytes) -> void {}

/// Thirty-two bytes of data
let ThirtyTwoBytes: struct {
  _, __: SixteenBytes
}
let New(self: ^ThirtyTwoBytes) -> void {}

/// Sixty-four bytes of data
let SixtyFourBytes: struct {
  _, __: ThirtyTwoBytes
}
let New(self: ^SixtyFourBytes) -> void {}
