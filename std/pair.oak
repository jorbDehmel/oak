/**
 * @file
 * @brief A templated 2-pair in Oak
 */

pragma!("no_dialect");

let pair<L, R> {
  /// A 2-pair
  let Pair: struct {
    first: L,
    second: R
  }

  /// Initialize from two values
  let Copy(self: ^Pair, first: L, second: R) -> Pair {
    self.first = first;
    self.second = second;
  }
}
