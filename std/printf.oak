/**
 * @file
 * @brief Defines the printf! macro in Oak
 */

pragma!("no_dialect");
include!("std/io.oak");

/**
 * @brief Given a format string and zero or more items, print
 * the format string with instances of '%' replaced by
 * those items.
 */
let printf!(c: i32, v: [][]i8) -> i32 {
  include!("std/io.oak", "std/operators.oak", "std/c_str.oak");

  let fstring_len, cur_obj, cur_fpos: uint;
  let in_print: bool;

  fstring_len = strlen(Get(v, 1uint));
  cur_obj = 2uint;
  cur_fpos = 1uint;
  in_print = false;

  while (cur_fpos + 1uint < fstring_len) {
    if (Get(Get(v, 1uint), cur_fpos) == Get("%", 0uint)) {
      // Print an obj
      if (in_print) {
        print("\");\n");
        in_print = false;
      }
      print("print(");
      print(Get(v, cur_obj));
      ++cur_obj;
      print(");\n");
    } else {
      // Char
      if (!in_print) {
        print("print(\"");
        in_print = true;
      }

      print(Get(Get(v, 1uint), cur_fpos));
    }

    ++cur_fpos;
  }

  if (in_print) {
    print("\");\n");
  }

  return 0i32;
}
