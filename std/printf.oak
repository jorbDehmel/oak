/*
Defines the printf! macro in Oak
*/

pragma!("no_dialect");
include!("std/io.oak");

let printf!(c: i32, v: [][]i8) -> i32 {
  include!("std/io.oak", "std/operators.oak", "std/c_str.oak");

  // 1st arg is format string
  // Rest are inserted whenever '%' is seen

  let fstring_len, cur_obj, cur_fpos: uint;
  let in_print: bool;

  fstring_len = strlen(Get(v, 1uint));
  cur_obj = 2uint;
  cur_fpos = 0uint;
  in_print = false;

  while (Less(cur_fpos, fstring_len)) {
    if (Get(Get(v, 1uint), cur_fpos) == Get("%", 0uint)) {
      // Print an obj
      if (in_print) {
        print("\");\n");
        in_print = false;
      }
      print("print(");
      print(Get(v, cur_obj));
      ++cur_obj;
      print(");\n");
    } else {
      // Char
      if (!in_print) {
        print("print(\"");
        in_print = true;
      }

      print(Get(Get(v, 1uint), cur_fpos));
    }

    ++cur_fpos;
  }

  if (in_print) {
    print("\");\n");
  }

  return 0i32;
}
