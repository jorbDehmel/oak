/*
Resources for package version control.
This defines a few compile-time checks, and should theoretically
be useable for both compile and runtime cases.
*/

package!("std");
use_rule!("std");
include!(
    "std/string.oak",
    "std/string_ops.oak",
    "std/assert.oak"
);

////////////////////////////////////////////////////////////////
// Struct def(s)

// Some basic information about a package.
// Includes major.minor.patch, as well as package name.
let pkg: struct
{
    major, minor, patch: u128,
    name: string,
}

////////////////////////////////////////////////////////////////
// Operators and whatnot

// DO NOT CALL THIS YOURSELF; Use `pkg!(NAME)` to ensure
// correctness!
let Copy(
    self: mut pkg,
    name: string,
    major: u128,
    minor: u128,
    patch: u128) -> pkg
{
    self.name = name;
    self.major = major;
    self.minor = minor;
    self.patch = patch;

    ^self
}

let Less(self: pkg, other: pkg) -> bool
{
    assert!(self.name == other.name);
    return (
        self.major < other.major
        || self.minor < other.minor
        || self.patch < other.patch
    );
}

let Great(self: pkg, other: pkg) -> bool
{
    assert!(self.name == other.name);
    return (other < self);
}

let Leq(self: pkg, other: pkg) -> bool
{
    assert!(self.name == other.name);
    return Not(other < self);
}

let Greq(self: pkg, other: pkg) -> bool
{
    assert!(self.name == other.name);
    return Not(self < other);
}

let Eq(self: pkg, other: pkg) -> bool
{
    assert!(self.name == other.name);
    return (
        self.major == other.major
        && self.minor == other.minor
        && self.patch == other.patch
    );
}

let Neq(self: pkg, other: pkg) -> bool
{
    assert!(self.name == other.name);
    return (
        self.major != other.major
        || self.minor != other.minor
        || self.patch != other.patch
    );
}

////////////////////////////////////////////////////////////////
// Forward-facing macro

// Takes one argument (the package name) and yields a tuple
// containing the information for a Copy call on the pkg struct.
let pkg!(c: i32, v: []str) -> i32
{
    package!("std");
    include!(
        "std/assert.oak",
        "std/printf.oak"
    );

    assert!(c == 2i32, "pkg! takes exactly one argument.");
    printf!(
        ```
        (%, pkg::__unwrap_version!(%::VERSION!))
        ```,
        v.Get(1u128), v.Get(1u128)
    );

    0i32
}

////////////////////////////////////////////////////////////////
// Internals

let pkg::__unwrap_version!(argc: i32, argv: []str) -> i32
{
    package!("std");
    use_rule!("std");

    include!(
        "std/assert.oak",
        "std/printf.oak",
        "std/string.oak",
        "std/cstr.oak"
    );

    assert!(argc == 2i32);

    let major, minor, patch, i, max: u128;
    let state: u8 = 1u8;
    let c: i8;
    let version: string = argv.Get(1u128);

    i = 0u128;
    max = version.size();
    major = minor = patch = 0u128;

    /*
    State:
    1 - on major
    2 - on minor
    3 - on patch
    */
    while i < max
    {
        c = version.Get(i);
        ++i;

        if c != to_i8(".") && !(c <= to_i8("9") && to_i8("0") <= c)
        {
            // Error: Invalid character
            print_err("Invalid character in version string!");
            return 1i32;
        }

        // On major version
        if state == 1u8
        {
            if c == to_i8(".")
            {
                state = 2u8;
            }
            else
            {
                major *= 10u128;
                major += pkg::__char_to_int(c);
            }
        }

        // On minor version
        else if state == 2u8
        {
            if c == to_i8(".")
            {
                state = 3u8;
            }
            else
            {
                minor *= 10u128;
                minor += pkg::__char_to_int(c);
            }
        }

        // On patch
        else if state == 3u8
        {
            if c == to_i8(".")
            {
                // Throw error
                print_err("Malformed format string!");
                return 2i32;
            }
            else
            {
                patch *= 10u128;
                patch += pkg::__char_to_int(c);
            }
        }
    }

    // major, minor, patch
    printf!("%, %, %", major, minor, patch);

    0i32
}
