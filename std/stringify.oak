/*
Macros for macros to use to standardize argument formatting.
*/

pragma!("no_dialect");

/*
Given some argument, make it so that its contents are surrounded
by no quotes.

alabama -> alabama
"alaska" -> alaska
"\"arizona\"" -> arizona
"\"arkansas" -> \"arkansas
"'california'" -> california
*/
let unstringify!(c: i32, v: [][]i8) -> i32 {
  include!("std/io.oak", "std/c_str.oak", "std/operators.oak");

  let start: uint; // First index not to ignore
  let end: uint;   // First index to ignore again
  start = 0uint;
  end = strlen(Get(v, 1u32));

  let flag: bool;
  flag = true;

  while (flag) {
    if (start >= end) {
      flag = false;
    } else if (Get(Get(v, 1u32), start) !=
      Get(Get(v, 1u32), end - 3uint)) {
      flag = false;
    } else if (
      Get(Get(v, 1u32), start) != Get("'", 0u32) &&
      Get(Get(v, 1u32), start) != Get('"', 0u32)
      && Get(Get(v, 1u32), start) != Get("`", 0u32)) {
      flag = false;
    } else {
      ++start;
      --end;
    }
  }

  // NOTE: We haven't dealt with backslashes!!!!
  while (start < end) {
    print(Get(Get(v, 1u32), start));
    ++start;
  }

  return 0i32;
}

/*
Given some argument, make it so that its contents are surrounded
by exactly one set of double quotes.

alabama -> "alabama"
"alaska" -> "alaska"
"\"arizona\"" -> "arizona"
"\"arkansas" -> "\"arkansas"
"'california'" -> "california"
*/
let stringify!(c: i32, v: [][]i8) -> i32 {
  include!("std/io.oak");

  print("\"hi\"");

  return 0i32;
}
