/*
Defines the `assert!` macro
*/

include!("std/io.oak");

let assert!(c: i32, v: [][]i8) -> i32 {
  include!("std/printf.oak");
  printf!(
    "if (Not(%)) {"
    "print(\"Failed assertion at \");"
    "print(FILE!);"
    "print(\":\");"
    "print(LINE!);"
    "endl();"
    "panic();"
    "}",
    Get(v, 1uint)
  );

  return 0i32;
}
