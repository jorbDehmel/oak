/*
Math stuff
*/

pragma!("no_dialect");
link!("std/math.o");

let math::e!  = 2.71828182f64;
let math::pi! = 3.14159265f64;

let pow(base: f64, exp: f64) -> f64;
let exp(power: f64) -> f64;
let sqrt(x: f64) -> f64;

let sin(rad: f64) -> f64;
let cos(rad: f64) -> f64;
let tan(rad: f64) -> f64;

let sinh(x: f64) -> f64;
let cosh(x: f64) -> f64;
let tanh(x: f64) -> f64;

let log(x: f64) -> f64;
let log2(x: f64) -> f64;
let log10(x: f64) -> f64;
let cbrt(x: f64) -> f64;
let hypot(a: f64, b: f64) -> f64;

let ceil(x: f64) -> f64;
let floor(x: f64) -> f64;
let round(x: f64) -> f64;
let round(x: f64, decimal_places: uint) -> f64;

let min(l: f64, r: f64) -> f64;
let max(l: f64, r: f64) -> f64;
let abs(x: f64) -> f64;
