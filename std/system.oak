/**
 * @file
 * @brief Interfaces with the std `C` system call and other
 * POSIX functions.
 */

pragma!("no_dialect");
link!("std/system.o");

/**
 * @brief Execute a system call and return the exit code. This
 * interfaces directly with C's `system` function: Therefore,
 * behavior is OS-specific!
 * @param cmd The command to execute
 * @returns 0 on success, nonzero on failure
 */
let system(cmd: []i8) -> i32;

/// Get the process ID
let get_pid() -> int;

/**
 * @brief POSIX fork: Split into two processes distinguishable
 * by the return value.
 * @returns 0 to child, child's PID (nonzero) to parent. < 0 on
 * error.
 */
let fork() -> int;

/// Get the user ID
let get_uid() -> int;

/// Get the effective user ID
let get_euid() -> int;
