/*
Defines the dynamically-allocated `str` class in Oak
*/

pragma!("no_dialect");
include!(
  "std/operators.oak",
  "std/io.oak",
  "std/panic.oak",
  "std/c_str.oak");

////////////////////////////////////////////////////////////////
// Struct definition

let str: struct {
  c_str: []i8,
  size: u64,
  max_size: u64
}

////////////////////////////////////////////////////////////////
// Signatures

let New(self: ^str) -> str;
let Del(self: ^str) -> void;
let Copy(self: ^str, other: str) -> str;
let Copy(self: ^str, other: []i8) -> str;
let Add(lhs: str, rhs: str) -> str;
let Mult(lhs: str, rhs: uint) -> str;

let reserve(self: ^str, size: uint) -> void;
let print(what: str) -> void;

////////////////////////////////////////////////////////////////
// Implementations

let New(self: ^str) -> str {
  self.size = 0u64;
  self.max_size = 0u64;
}

let Del(self: ^str) -> void {
  if (self.size != 0u64) {
    free!(self.c_str);
    self.size = 0u64;
  }
}

let Copy(self: ^str, other: str) -> str {
  Del(self);
  self.size = other.size;
  strcpy(self.c_str, other.c_str);
  return ^self;
}

let Copy(self: ^str, other: []i8) -> str {
  Del(self);
  self.size = to_u64(strlen(other));
  strcpy(self.c_str, other);
  return ^self;
}

let Add(lhs: str, rhs: str) -> str {
  panic();
}

let Mult(lhs: str, rhs: uint) -> str {
  panic();
}

let reserve(self: ^str, size: uint) -> void {
  self.size = size;
  alloc!(self.c_str, self.size);
}

let print(what: str) -> void {
  print(what.c_str);
}
