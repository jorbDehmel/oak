/*
Provides the `iterable` trait.
*/

package!("std");
use_rule!("std");

/*
This trait is true for the given types `on, iterator` if an only
if `iterator` is a type which defines iterator functions over
`on`.
*/
let iterable<on, iterator>: trait
{
    // Returns a beginning iterator
    where on does begin(_: mut on);

    // Copy an iterator
    where iterator does Copy(_: mut iterator, _: iterator);

    // Returns whether the iteration is done or not (bool)
    where on does end(_: mut on, _: mut iterator);

    // Advances the iterator by one forward
    where iterator does Incr(_: mut iterator);

    // Fetches a reference to the current object
    where iterator does get(_: mut iterator);
}

// WIP
let iterable<on>: trait
{
    where on does begin(_: mut on);

    // Dummy object used for typing; This never exists at
    // runtime, and only exists theoretically at compile time
    // for typing purposes.
    let __obj: on;

    // it! represents the iterator type, derived from the
    // return type of `begin`.
    let it! = type!(begin(__obj));

    // Increment
    where it! does Incr(_: mut it!);

    // Deref
    where it! does get(_: mut it!);

    // End
    where on does end(_: mut on, _: mut it!);
}
