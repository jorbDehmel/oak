/**
 * @file
 * @brief Linkage file for the `std` Oak package. This is to be
 * used as an entry point when the normal `std` files are
 * wanted.
 */

pragma!("no_dialect");

include!(
  "std/spec.oak",
  "std/io.oak",
  "std/math.oak",
  "std/panic.oak",
  "std/random.oak",
  "std/system.oak",
  "std/operators.oak",
  "std/casts.oak",
  "std/rules.oak"
);
