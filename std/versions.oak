/*
Resources for comparing package version strings at compile-time.
*/

include!("std/panic.oak", "std/io.oak");

/*
Takes in two strings: The first is the existing package version,
the second is the desired version. Only exits without error if
the constraint is satisfied.

Examples (letting oak::VERSION! be 0.0.8):

// Fails: Not greq
versions::compare!(oak::VERSION!, "0.1.0");

// Fails: Not lt
versions::compare!(oak::VERSION!, "<0");

// Fails: Not equal
versions::compare!(oak::VERSION!, "=0");
*/
let versions::compare!(c: i32, v: [][]i8) -> i32 {
  include!("std/io.oak", "std/c_str.oak");

  let exit_code: i32;
  exit_code = 0i32;

  if (c != 3) {
    print(
      `compile_time::error!(`
      `"Invalid versions::compare! call\n");`
    );
  } else if (Get(Get(v, 1), 0) == Get("<", 0)) {
    // Less than
  } else if (Get(Get(v, 1), 0) == Get("=", 0)) {
    // Equal to
  } else {
    // Greater than or equal to
  }

  return exit_code;
}
