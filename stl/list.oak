/*
Doubly linked list in Oak. Part of stl.
*/

pragma!("no_dialect");

////////////////////////////////////////////////////////////////
// Structs

let stl::List::Node<T> : struct {
  data: T,
  __prev: ^stl::List::Node<T>,
  __next: ^stl::List::Node<T>
}

let stl::List<T> : struct {
  __head: ^stl::List::Node<T>,
  __tail: ^stl::List::Node<T>
} post {
  let New<T>(_: ^stl::List::Node<T>) -> void;
  let Copy<T>(_: ^stl::List::Node<T>, _: T
    ) -> stl::List::Node<T>;
  let Del<T>(_: ^stl::List::Node<T>) -> void;
}

////////////////////////////////////////////////////////////////
// Methods

let New<T>(self: ^stl::List::Node<T>) -> void {
  New(self.data);
  self.__prev = 0u64;
  self.__next = 0u64;
}

let Copy<T>(self: ^stl::List::Node<T>,
    data: T) -> stl::List::Node<T> {
  self.data = data;
}

let Del<T>(self: ^stl::List::Node<T>) -> void {
  if (self.next != 0u64) {
    Del(self.next);
    free!(self.next);
  }
  Del(self.data);
}

let push_front<T>(self: ^stl::List<T>, d: T) -> void {
}

let push_back<T>(self: ^stl::List<T>, d: T) -> void {
}

let front<T>(self: ^stl::List<T>) -> T {
}

let back<T>(self: ^stl::List<T>) -> T {
}

let empty<T>(self: ^stl::List<T>) -> bool {
}

let pop_front<T>(self: ^stl::List<T>) -> void {
}

let pop_back<T>(self: ^stl::List<T>) -> void {
}
