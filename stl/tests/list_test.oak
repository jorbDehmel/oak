/*
Tests the stl::List<T> class
*/

include!(
  "std/std.oak",
  // "std/rules.oak",
  "std/printf.oak",
  "stl/list.oak"
);
rule::use!("std");

let main() -> i32 {
  let l: List<u64>;

  let i = 0u64;
  while (i < 128u64) {
    l.push_front(i);
    ++i;
  }

  while (!l.empty()) {
    printf!("% ", l.back());
    l.pop_back();
  }
  endl();

  return 0i32;
}
