/*
Initial test of SDL2 interfacial package
*/

pragma!("no_run");
include!(
  "std/std.oak",
  "std/rules.oak",
  "sdl/sdl.oak"
);
rule::use!("std");

let main() -> i32 {
  sdl::init();

  let w! = 1024u64;
  let h! = 1024u64;
  let frame_delay! = 10u64;
  let key_buffer_size! = 64uint;

  let black, white, red: sdl::Color;
  let window: sdl::Window;
  let player: sdl::Rect;
  let frame_start, frame_end: u64;
  let e: sdl::Event;
  let flag: bool;
  let is_running: bool;
  let key_buffer: [key_buffer_size!]i8;

  black =  (0u8,   0u8,   0u8,   255u8);
  white =  (255u8, 255u8, 255u8, 255u8);
  red =    (255u8, 0u8,   0u8,   255u8);
  player = (0int, 0int, 4int, 4int);
  window = (w!, h!);

  is_running = true;
  while (is_running) {
    frame_start = sdl::get_ticks();

    let player_point: sdl::Coord;
    player_point = (player.x, player.y);

    fill(window, black);
    draw_rect(window, player, white);
    draw_dot(window, player_point, red);
    show(window);

    wrap_none(e);
    flag = true;
    while (flag) {
      e = sdl::poll_event();
      match (e) {
        case quit_event(_: Unit) {
          is_running = false;
        } case none(_: Unit) {
          flag = false;
        } case key_down_event(data: sdl::KeyEventData) {
          sdl::to_str(
            data.keycode, key_buffer, key_buffer_size!);
        } case key_up_event(_: sdl::KeyEventData) {
          Get(key_buffer, 0uint) = 0i8;
        }
      }
    }

    if (key_buffer == "SDLK_UP" && player.y > 0int) {
      --player.y;
    } else if (key_buffer == "SDLK_DOWN"
      && player.y < to_i64(h! - 4u64)) {
      ++player.y;
    } else if (key_buffer == "SDLK_LEFT"
      && player.x > 0int) {
      --player.x;
    } else if (key_buffer == "SDLK_RIGHT"
      && player.x < to_i64(w! - 4u64)) {
      ++player.x;
    } else if (key_buffer == "SDLK_ESCAPE") {
      is_running = false;
    }

    frame_end = sdl::get_ticks();
    if (frame_end - frame_start < frame_delay!) {
      sdl::delay(
        to_i32(frame_delay! - frame_end + frame_start));
    }
  }

  sdl::quit();
  return 0i32;
}
